PORT=4321
OFFLINE_TIMEOUT_MS=900000
CEO_PANEL_TOKEN=CAMBIA_ESTE_TOKEN_POR_UNO_LARGO_Y_PRIVADO

# Token que deben mandar tus automatizaciones (n8n, scripts, lo que sea) en la
# cabecera "X-Heartbeat-Token" al llamar a POST /api/heartbeat. Sin esto, el
# endpoint responde 401 — es asi a proposito, para que nadie pueda escribir
# datos falsos en tu panel. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HEARTBEAT_TOKEN=CAMBIA_ESTE_TOKEN_POR_UNO_LARGO_Y_PRIVADO

# Login del panel (/office, /operations, /manual y sus APIs exigen sesion).
# ADMIN_PASSWORD_HASH NUNCA es la contraseña en texto plano — genera el hash con:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('TU_CONTRASEÑA',s,64).toString('hex'))"
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD_HASH=salt_generado:hash_generado

DATA_FILE=/app/data/state.json

# Opcional: solo si usas el widget embebible de WordPress (renderWordpressEmbedJs).
# Deja vacio si no lo usas — el resto de la oficina funciona igual.
PUBLIC_OFFICE_URL=

# Opcional: si quieres que la consola de instrucciones del CEO pueda disparar
# automatizaciones reales de n8n en lenguaje natural (ver
# docs/ejemplo-n8n-workflow.json y el catalogo REGLAS_AUTOMATIZACION_REAL en
# server.js). Sin esto, la consola solo registra la instruccion, no dispara nada.
OPENAI_API_KEY=

# Opcional: solo si usas la bandeja de entrada (/api/inbox) para reenviar
# respuestas a un workflow de n8n propio.
N8N_INBOX_WEBHOOK_URL=
N8N_INBOX_TOKEN=

